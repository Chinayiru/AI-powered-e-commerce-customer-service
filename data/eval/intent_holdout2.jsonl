{"case_id": "HT11", "text": "用了三天就黑屏，退款，机子我寄回。", "intent": "refund", "aftersales_type": "return_refund", "hard": true, "note": "寄回退款"}
{"case_id": "HT12", "text": "收到的鞋码大一码，退回去换。", "intent": "refund", "aftersales_type": "return_refund", "hard": false, "note": "尺码换货"}
