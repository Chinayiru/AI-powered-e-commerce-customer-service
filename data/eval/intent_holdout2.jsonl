{"case_id": "HT08", "text": "商品写着第二件半价，结果没减，退差价。", "intent": "refund", "aftersales_type": "refund_only", "hard": true, "note": "活动价差"}
{"case_id": "HT09", "text": "收到的杯盖裂了，退货退款。", "intent": "refund", "aftersales_type": "return_refund", "hard": false, "note": "破损退货"}
