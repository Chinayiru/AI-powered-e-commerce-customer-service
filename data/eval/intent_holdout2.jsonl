{"case_id": "HT14", "text": "耳机只有一个响，我要退货。", "intent": "refund", "aftersales_type": "return_refund", "hard": false, "note": "质量问题"}
{"case_id": "HT15", "text": "麻烦把地址改到公司，其他不变。", "intent": "address_change", "aftersales_type": null, "hard": false, "note": "改地址"}
