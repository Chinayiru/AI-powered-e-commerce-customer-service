# 复制为 .env 后填入真实值；.env 已被 git 忽略，禁止提交密钥
# scripted | openai_compat | auto（auto 与 openai_compat 同标准：配置不齐直接报错，不静默回退）
AFTERSALE_LLM_PROVIDER=openai_compat
AFTERSALE_LLM_BASE_URL=https://your-gateway.example.com/v1
AFTERSALE_LLM_MODEL=your-model-id
AFTERSALE_LLM_API_KEY=sk-your-key

# 写接口的操作人表："id:token,id:token"。未配置时 POST /api/runs 一律 503。
# 控制台右上角"未登录操作人"处填入 id/令牌即可；令牌只在本机使用，勿用真实口令。
AFTERSALE_OPERATORS=demo1:tok-demo1
